# Orange Pi 4 Pro / A733 E902 remoteproc support fragment
#
# CI: .github/workflows/orangepi4pro-kernel.yml merges this into the a733 board
# config (.github/ci/linux-sun60iw2-current-a733.config, sourced from
# orangepi-build external/config/kernel/linux-sun60iw2-current-a733.config).
#
# Full SD/eMMC images still come from orangepi-build (BOARD=orangepi4pro
# BRANCH=current). Kernel-only CI lives in this linux-orangepi tree.
#
# U-Boot (u-boot-orangepi v2018.05-sun60iw2): leave as-is while SCP owns E902.
# sun60iw2p1_t736_defconfig already sets CONFIG_ARISC_DEASSERT_BEFORE_KERNEL and
# boot_package.cfg packs scp.fex. Change U-Boot only if Linux should take E902
# (omit scp from the boot package / skip ARISC deassert).
#
# Merge into the board kernel config, e.g.:
#   scripts/kconfig/merge_config.sh .config arch/arm64/configs/sun60iw2-e902-remoteproc.config
#
# Then enable the DT node on the board (E902 is normally TF-A ARISC/SCP):
#   &e902ddr_reserved { status = "okay"; };
#   &e902_vdev0buffer { status = "okay"; };
#   &e902_vdev0vring0 { status = "okay"; };
#   &e902_vdev0vring1 { status = "okay"; };
#   &e902_rproc { status = "okay"; only-boot; };
#
# Link firmware for E902 VA 0x40000000 (SRAM) or 0x4a100000 (DDR carveout).
#
CONFIG_REMOTEPROC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_VIRTIO=y
CONFIG_MAILBOX=y
CONFIG_AW_MSGBOX=y
CONFIG_AW_REMOTEPROC=y
CONFIG_AW_REMOTEPROC_E902_BOOT=y
